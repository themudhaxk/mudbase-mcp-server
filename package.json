{
  "name": "mudbase-mcp-server",
  "version": "0.1.1",
  "description": "MCP server that exposes Mudbase's database, storage, and search capabilities as tools for Claude Code and other MCP clients, gated by a Mudbase API key.",
  "type": "module",
  "license": "MIT",
  "author": "Mudbase Team",
  "homepage": "https://mudbase.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themudhaxk/mudbase-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/themudhaxk/mudbase-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mudbase",
    "baas",
    "claude",
    "claude-code",
    "database",
    "storage"
  ],
  "bin": {
    "mudbase-mcp-server": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.7.9",
    "form-data": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
